---
/**
 * Диаграммы связки «клиентский балансировщик + серверный роутинг».
 * variant="alike": однородный пул, оба слоя работают — клиент выбирает вход
 * из пула, роутинг ведёт российский трафик через сервер выхода.
 * variant="mixed": смешанный пул, собранный с разных инбаундов, — отдельный
 * профиль берёт правила первого хоста, и нода без файла списков падает.
 * lang="ru" (по умолчанию) / lang="en" — язык подписей.
 */
interface Props {
  variant?: 'alike' | 'mixed';
  lang?: 'ru' | 'en';
}
const { variant = 'alike', lang = 'ru' } = Astro.props;
const en = lang === 'en';
const mixed = variant === 'mixed';
---

<div class="rcd">
  <svg viewBox="0 0 640 340" role="img" aria-label={en
    ? (mixed
        ? 'A mixed pool gathered across inbounds: the dedicated profile takes the rules of the first host, and a node without the list file goes down'
        : 'A uniform pool: the client picks the entry from the pool, server routing sends Russian traffic through the exit server')
    : (mixed
        ? 'Смешанный пул, собранный с разных инбаундов: отдельный профиль берёт правила первого хоста, нода без файла списков падает'
        : 'Однородный пул: клиент выбирает вход из пула, серверный роутинг ведёт российский трафик через сервер выхода')}>
    <!-- клиент -->
    <g class="node n-cli">
      <rect x="14" y="140" width="170" height="60" rx="14" />
      <text x="99" y="163" class="t">{en ? 'client' : 'клиент'}</text>
      <text x="99" y="181" class="s">v2rayN · Happ</text>
    </g>

    <!-- пул входных нод -->
    <text x="335" y="52" class="grp g-main">{en ? 'entry pool' : 'пул входных нод'}</text>
    {mixed ? (
      <>
        <g class="node n-win">
          <rect x="250" y="62" width="170" height="52" rx="12" />
          <text x="335" y="83" class="t">{en ? 'node with routing' : 'нода с роутингом'}</text>
          <text x="335" y="102" class="s win">{en ? 'alive' : 'живая'}</text>
        </g>
        <g class="node n-dead">
          <rect x="250" y="190" width="170" height="52" rx="12" />
          <text x="335" y="211" class="t">{en ? 'node, no lists' : 'нода без списков'}</text>
          <text x="335" y="230" class="s dead">{en ? 'went down' : 'упала'}</text>
        </g>

        <path class="wire w-win" d="M184 158 C 214 158, 224 88, 250 88" />
        <path class="flow f-mint" d="M184 158 C 214 158, 224 88, 250 88" />
        <path class="wire" d="M184 166 C 214 166, 224 216, 250 216" />
        <text x="217" y="182" class="cross">✖</text>
        <path class="wire w-two" d="M420 88 C 448 82, 452 74, 470 70" />
        <path class="flow f-vio" d="M420 88 C 448 82, 452 74, 470 70" />

        <g class="pill">
          <rect x="152" y="246" width="130" height="22" rx="11" />
          <text x="217" y="261">{en ? 'no list file' : 'нет файла списков'}</text>
        </g>
        <g class="chip">
          <rect x="40" y="290" width="250" height="26" rx="8" />
          <circle cx="54" cy="303" r="3.5" />
          <text x="66" y="308" class="ct">{en ? 'rules of the first host' : 'правила первого хоста'}</text>
        </g>
        <text x="320" y="330" class="cap mid">{en
          ? 'an across-inbounds build takes down the node without the mounted list file'
          : 'сборка с разных инбаундов роняет ноду без файла списков'}</text>
      </>
    ) : (
      <>
        <g class="node n-pool">
          <rect x="250" y="62" width="170" height="52" rx="12" />
          <text x="335" y="83" class="t">{en ? 'node DE-1' : 'нода DE-1'}</text>
          <text x="335" y="102" class="s">{en ? 'routing on' : 'роутинг включён'}</text>
        </g>
        <g class="node n-pool">
          <rect x="250" y="190" width="170" height="52" rx="12" />
          <text x="335" y="211" class="t">{en ? 'node DE-2' : 'нода DE-2'}</text>
          <text x="335" y="230" class="s">{en ? 'routing on' : 'роутинг включён'}</text>
        </g>

        <path class="wire w-win" d="M184 158 C 214 158, 224 88, 250 88" />
        <path class="flow f-mint" d="M184 158 C 214 158, 224 88, 250 88" />
        <path class="wire w-two" d="M184 166 C 214 166, 224 216, 250 216" />
        <path class="flow f-teal" d="M184 166 C 214 166, 224 216, 250 216" />

        <g class="pill">
          <rect x="130" y="128" width="120" height="22" rx="11" />
          <text x="190" y="143">{en ? 'balancer' : 'балансировщик'}</text>
        </g>
        <g class="chip">
          <rect x="40" y="280" width="250" height="26" rx="8" />
          <circle cx="54" cy="293" r="3.5" />
          <text x="66" y="298" class="ct">{en ? 'RU domains → exit' : 'RU-домены → сервер выхода'}</text>
        </g>
        <g class="chip c-ig">
          <rect x="40" y="312" width="250" height="26" rx="8" />
          <circle cx="54" cy="325" r="3.5" />
          <text x="66" y="330" class="ct">{en ? 'everything else → direct' : 'остальное → напрямую'}</text>
        </g>
        <text x="548" y="332" class="cap mid">{en ? 'layers do not collide' : 'слои не мешают'}</text>
      </>
    )}

    <!-- сервер выхода и интернет -->
    <g class="node n-vio">
      <rect x="470" y="40" width="156" height="60" rx="12" />
      <text x="548" y="64" class="t">{en ? 'exit server' : 'сервер выхода'}</text>
      <text x="548" y="82" class="s">{en ? 'SS bridge' : 'SS-мост'}</text>
    </g>
    <g class="node n-cli">
      <rect x="470" y="240" width="156" height="52" rx="12" />
      <text x="548" y="262" class="t">{en ? 'internet' : 'интернет'}</text>
      <text x="548" y="280" class="s">{en ? 'direct' : 'напрямую'}</text>
    </g>
  </svg>
</div>

<style>
  .rcd{
    background:#0a0f0c;border:1px solid #2a4737;border-radius:12px;
    padding:1rem 1.25rem;margin:1rem 0;overflow-x:auto;
    box-shadow:0 14px 40px rgba(0,0,0,.35);
  }
  .rcd svg{display:block;width:100%;min-width:600px;height:auto;
    font-family:var(--sl-font-mono, ui-monospace, Consolas, monospace)}
  .wire{fill:none;stroke:#24344a;stroke-width:2}
  .w-win{stroke:#2a4737}
  .w-two{stroke:#1d4a4d}
  .flow{fill:none;stroke-width:2;stroke-linecap:round;
    stroke-dasharray:4 12;animation:rcd-flow 1.1s linear infinite}
  .f-mint{stroke:#00e5a0}
  .f-teal{stroke:#39c5cf}
  .f-vio{stroke:#bc8cff}
  @keyframes rcd-flow{to{stroke-dashoffset:-16}}

  .node rect{fill:#0e1a14;stroke:#2a4737;stroke-width:1.5}
  .n-cli rect{stroke-dasharray:5 4}
  .n-win rect{stroke:rgba(0,229,160,.55)}
  .n-pool rect{stroke:rgba(0,229,160,.35)}
  .n-vio rect{stroke:rgba(188,140,255,.55)}
  .n-dead rect{opacity:.55}
  .node .t{fill:#e9f4ec;font-size:14px;font-weight:600;text-anchor:middle}
  .n-vio .t{fill:#cdaaff}
  .n-dead .t{fill:#8ca08f}
  .node .s{fill:#a9c0b0;font-size:12px;text-anchor:middle}
  .node .s.win{fill:#7defc4}
  .node .s.dead{fill:#ff8a8a}

  .grp{font-size:11px;letter-spacing:.14em;text-transform:uppercase;text-anchor:middle}
  .g-main{fill:#7defc4}

  .cross{fill:#ff5d5d;font-size:15px;font-weight:700;text-anchor:middle}

  .pill rect{fill:#0a0f0c;stroke:rgba(0,229,160,.35);stroke-width:1.5}
  .pill text{fill:#a9c0b0;font-size:12px;text-anchor:middle}

  .chip rect{fill:#0e1a14;stroke:rgba(0,229,160,.55);stroke-width:1.5}
  .c-ig rect{stroke:rgba(57,197,207,.5)}
  .chip circle{fill:#00e5a0}
  .c-ig circle{fill:#39c5cf}
  .chip .ct{fill:#7defc4;font-size:13px;font-weight:600}
  .c-ig .ct{fill:#9cc7ff}

  .cap{fill:#8ca08f;font-size:12.5px}
  .cap.mid{text-anchor:middle}

  @media (prefers-reduced-motion: reduce){
    .flow{animation:none;stroke-dasharray:none;opacity:.9}
  }
</style>
