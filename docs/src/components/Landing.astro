<script>
  const root = document.querySelector('.rr-landing') as HTMLElement | null;
  if (root) {
    const en = !document.documentElement.lang.toLowerCase().startsWith('ru');
    root.querySelectorAll<HTMLButtonElement>('[data-copy-cmd]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const cmd = btn.closest('.cmd-row')?.getAttribute('title') || '';
        navigator.clipboard?.writeText(cmd).catch(() => {});
        toast();
        const label = btn.querySelector('[data-copy-label]');
        if (label) {
          label.textContent = en ? 'copied' : 'скопировано';
          setTimeout(() => (label.textContent = en ? 'copy' : 'копировать'), 1600);
        }
      });
    });

    // плашка «скопировано» — общая для всех копирований
    document.documentElement.style.setProperty(
      '--sb-w',
      window.innerWidth - document.documentElement.clientWidth + 'px',
    );
    const toastEl = root.querySelector<HTMLElement>('.copy-toast');
    let toastTimer = 0;
    const toast = () => {
      if (!toastEl) return;
      toastEl.classList.add('show');
      clearTimeout(toastTimer);
      toastTimer = window.setTimeout(() => toastEl.classList.remove('show'), 1800);
    };

    // живой счётчик звёзд у кнопки GitHub
    const starsEl = root.querySelector<HTMLElement>('[data-stars]');
    if (starsEl) {
      fetch('https://api.github.com/repos/eGamesAPI/remnawave-reverse-proxy', {
        headers: { Accept: 'application/vnd.github+json' },
      })
        .then((r) => r.json())
        .then((d) => {
          if (typeof d.stargazers_count === 'number') {
            starsEl.textContent = '★ ' + d.stargazers_count.toLocaleString(en ? 'en-US' : 'ru-RU');
          }
        })
        .catch(() => {});
    }

    // карточка USDT: клик копирует адрес кошелька
    const usdtBtn = root.querySelector<HTMLButtonElement>('[data-usdt]');
    if (usdtBtn) {
      usdtBtn.addEventListener('click', () => {
        navigator.clipboard?.writeText(usdtBtn.dataset.usdt || '').catch(() => {});
        toast();
        const go = usdtBtn.querySelector('.comm-go');
        if (go) {
          const old = go.innerHTML;
          go.textContent = '✓';
          setTimeout(() => {
            go.innerHTML = old;
          }, 1600);
        }
      });
    }

    // демо «сканер / с ключом» в секции скрытой панели
    const demo = root.querySelector<HTMLElement>('.demo');
    if (demo) {
      const urlEl = demo.querySelector<HTMLElement>('.demo-url');
      const views = demo.querySelectorAll<HTMLElement>('[data-view]');
      const btns = demo.querySelectorAll<HTMLButtonElement>('[data-demo]');
      const setView = (name: string) => {
        views.forEach((v) => (v.hidden = v.dataset.view !== name));
        btns.forEach((b) => b.classList.toggle('on', b.dataset.demo === name));
        if (urlEl) {
          urlEl.textContent = name === 'owner' ? urlEl.dataset.key || '' : urlEl.dataset.plain || '';
          urlEl.classList.toggle('key', name === 'owner');
        }
      };
      btns.forEach((b) => b.addEventListener('click', () => setView(b.dataset.demo || 'scanner')));
    }

    // счётчики статистики
    const counters = root.querySelectorAll<HTMLElement>('[data-count]');
    if (counters.length && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
      counters.forEach((el) => {
        const target = parseInt(el.dataset.count || '0', 10);
        const t0 = performance.now();
        const dur = 900;
        const tick = (t: number) => {
          const k = Math.min(1, (t - t0) / dur);
          el.textContent = String(Math.round(target * (1 - Math.pow(1 - k, 3))));
          if (k < 1) requestAnimationFrame(tick);
        };
        requestAnimationFrame(tick);
      });
    }

    // появление секций при скролле
    const revealTargets = root.querySelectorAll<HTMLElement>('.sec .in > *');
    if (revealTargets.length && !matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window) {
      revealTargets.forEach((el) => {
        el.classList.add('rr-wait');
      });
      const io = new IntersectionObserver((entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) {
            e.target.classList.remove('rr-wait');
            e.target.classList.add('rr-in');
            io.unobserve(e.target);
          }
        });
      }, { threshold: 0.15 });
      revealTargets.forEach((el) => io.observe(el));
    }

    // терминал героя: живое проигрывание как у оригинала —
    // команда, главное меню, выбор пунктов и ход установки, по кругу
    const termHost = root.querySelector<HTMLElement>('.hero-term');
    const termPre = root.querySelector<HTMLElement>('.hero-term .term pre');
    if (termHost && termPre) {
      const L = JSON.parse(termHost.dataset.play || '{}');
      const REDUCED = matchMedia('(prefers-reduced-motion: reduce)').matches;
      const sleep = (ms: number) => new Promise((r) => setTimeout(r, ms));
      let visible = true;
      new IntersectionObserver((es) => {
        visible = es[0].isIntersecting;
      }, { threshold: 0.1 }).observe(termHost);
      const gate = async () => {
        while (!visible || document.hidden) await sleep(300);
      };

      const row = (cls: string) => {
        const el = document.createElement('span');
        el.className = cls ? `ln ${cls}` : 'ln';
        termPre.appendChild(el);
        termPre.scrollTop = termPre.scrollHeight;
        return el;
      };
      const print = async (defs: Array<[string, string] | [string, string, string?]>, step = 36) => {
        for (const d of defs) {
          await gate();
          const el = row(d[0]);
          // номера пунктов меню — жёлтым, как в самом скрипте
          const m = d[0] === 'item' ? d[1].match(/^(\d+\.)\s?([\s\S]*)$/) : null;
          if (m) {
            const n = document.createElement('span');
            n.className = 'num';
            n.textContent = m[1];
            el.appendChild(n);
            el.appendChild(document.createTextNode(m[2] || '\u00a0'));
          } else if (d[2] !== undefined) {
            el.textContent = d[1];
            const v = document.createElement('span');
            v.className = 'val';
            v.textContent = d[2];
            el.appendChild(v);
          } else {
            el.textContent = d[1] || '\u00a0';
          }
          termPre.scrollTop = termPre.scrollHeight;
          if (!REDUCED) await sleep(step);
        }
      };
      const typeInto = async (el: HTMLElement, text: string, cls: string, speed = 22) => {
        const span = document.createElement('span');
        span.className = cls;
        el.appendChild(span);
        const cur = document.createElement('span');
        cur.className = 'caret';
        el.appendChild(cur);
        for (const ch of text) {
          await gate();
          span.textContent += ch;
          termPre.scrollTop = termPre.scrollHeight;
          if (!REDUCED) await sleep(speed);
        }
        cur.remove();
      };
      const ask = async (label: string) => {
        const el = row('');
        const lbl = document.createElement('span');
        lbl.className = 'dim';
        lbl.textContent = `${label} `;
        el.appendChild(lbl);
        await typeInto(el, '1', 'p-sel', 220);
      };

      const mainDefs = (): Array<[string, string]> => {
        const defs: Array<[string, string]> = [
          ['title', L.title],
          ['dim', ` ${L.ver} `],
          ['plain', ''],
        ];
        (L.menu as string[]).forEach((m, i) => {
          defs.push(['item', `${i + 1}. ${m}`]);
        });
        defs.push(['plain', ''], ['item', `0. ${L.exit}`], ['plain', ''], ['dim', L.fast], ['plain', '']);
        return defs;
      };
      const installDefs = (): Array<[string, string]> => [
        ['title', L.menu[0]],
        ['plain', ''],
        ...(L.inst as string[]).map((m, i) => ['item', `${i + 1}. ${m}`] as [string, string]),
        ['plain', ''],
        ['item', `0. ${L.exit}`],
        ['plain', ''],
      ];
      const webDefs = (): Array<[string, string]> => [
        ['title', L.webTitle],
        ['plain', ''],
        ['item', '1. Nginx'],
        ['item', '2. Caddy'],
        ['plain', ''],
      ];
      const progDefs = (): Array<[string, string]> =>
        (L.prog as string[]).map((p) => ['ans', p] as [string, string]);

      const runCmd = async () => {
        const cmdLine = row('');
        const pr = document.createElement('span');
        pr.className = 'p-pr';
        pr.textContent = 'root@vps:~# ';
        cmdLine.appendChild(pr);
        await typeInto(cmdLine, L.cmd, 'p-cmd', 14);
      };

      if (REDUCED) {
        runCmd();
        row('plain');
        print(mainDefs());
      } else {
        (async () => {
          await gate();
          await sleep(600); // дать терминалу докрутить «включение» экрана
          await runCmd();
          await sleep(650);
          for (;;) {
            termPre.textContent = '';
            await print(mainDefs());
            await sleep(500);
            await ask(L.promptMain);
            await sleep(600);
            termPre.textContent = '';
            await print(installDefs());
            await sleep(400);
            await ask(L.instPrompt);
            await sleep(600);
            termPre.textContent = '';
            await print(webDefs());
            await ask(L.webPrompt);
            await sleep(500);
            termPre.textContent = '';
            await print(progDefs(), 550);
            await sleep(500);
            termPre.textContent = '';
            await print(L.done, 140);
            await sleep(4200);
            termPre.textContent = '';
          }
        })();
      }
    }
  }
</script>

<style>
  .rr-landing {
    font-family: var(--sl-font, sans-serif);
    color: #c3d8cb;
    padding-bottom: 0.1rem;
    background:
      radial-gradient(900px 420px at 75% 120px, rgba(0, 240, 176, 0.055), transparent 62%),
      radial-gradient(800px 500px at 15% 40%, rgba(0, 192, 128, 0.04), transparent 60%);
  }
  .rr-landing code { font-family: var(--sl-font-mono, monospace); }

  /* общий каркас: контент потолком 1400px; секции и футер красятся
     на всю ширину окна, поэтому сами вылезают за боковые поля лендинга */
  .rr-landing {
    --edge: clamp(1rem, 4vw, 2rem);
    overflow-x: clip;
  }
  .hero,
  .sec .in {
    width: 100%;
    max-width: 1400px;
    margin-inline: auto;
  }

  .hero,
  .sec {
    margin-block: 0 !important;
  }
  .hero {
    padding-inline: 0 !important;
  }
  .sec {
    margin-inline: calc(-1 * var(--edge)) !important;
    padding-inline: var(--edge) !important;
  }

  /* первый экран: герой и бегущая строка вместе закрывают вьюпорт,
     строка прижата к нижней кромке, как у референса */
  .first {
    display: flex;
    flex-direction: column;
    min-height: calc(100dvh - var(--sl-nav-height, 4rem));
  }
  .first .hero { flex: 1 1 auto; }

  /* герой: две колонки, терминальная заметно уже текстовой */
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.18fr) minmax(0, 0.82fr);
    gap: clamp(1.5rem, 3.5vw, 3rem);
    align-items: center;
    padding-block: clamp(2.75rem, 7vh, 4.5rem) clamp(2.25rem, 6vh, 3.75rem) !important;
  }
  .hero-copy { width: 100% !important; margin-inline: 0 !important; }
  .hero .hero-term { width: 100% !important; }
  .hero .stats { margin-top: 0 !important; }
  .badge {
    display: inline-block;
    font-family: var(--sl-font-mono, monospace);
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #00e5a0;
    border: 1px solid rgba(0, 229, 160, 0.3);
    border-radius: 999px;
    padding: 0.3rem 0.8rem;
    margin-bottom: 1.1rem;
  }
  .hero h1 {
    font-family: var(--sl-font-mono, monospace);
    font-size: clamp(2.2rem, 4.6vw, 3.7rem);
    font-weight: 700;
    line-height: 1.06;
    letter-spacing: -0.035em;
    color: #eef7f0;
    margin: 0 0 1.1rem;
  }
  /* вторая строка заголовка — как в оригинале: тот же кегль,
     вся фраза «одной командой.» держится вместе */
  .h1-l2 { white-space: nowrap; display: inline-block; max-width: 100%; }
  .grad {
    background: linear-gradient(96deg, #00f0b0 10%, #62ffd2 90%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    padding-inline-end: 0.06em;
  }
  .lead {
    font-size: clamp(0.95rem, 1.4vw, 1.08rem);
    line-height: 1.6;
    color: #a9c0b0;
    max-width: 34em;
    margin: 0 0 1.3rem;
  }
  .cta { display: flex; flex-wrap: wrap; gap: 0.8rem; margin-bottom: 1.1rem; }
  .cta.center { justify-content: center; }
  .btn {
    display: inline-flex; align-items: center; gap: 0.5rem;
    padding: 0.75rem 1.5rem; border-radius: 999px;
    font-size: 0.95rem; font-weight: 600; text-decoration: none;
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), filter 0.25s ease, border-color 0.25s ease;
  }
  .btn:active { transform: scale(0.97); }
  .btn.primary {
    position: relative; overflow: hidden;
    background: linear-gradient(180deg, #5cffd0, #00f0b0 55%, #00dca2);
    color: #04241a;
    font-weight: 700; font-size: 1rem;
    padding: 0.9rem 2rem;
    box-shadow:
      0 12px 36px -10px rgba(0, 240, 176, 0.6),
      inset 0 1px 0 rgba(255, 255, 255, 0.4),
      inset 0 -2px 6px rgba(0, 90, 70, 0.22);
  }
  .btn.primary::after {
    content: ''; position: absolute; top: 0; bottom: 0; left: -70%;
    width: 45%; transform: skewX(-20deg);
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.55), transparent);
    transition: left 0.55s ease;
  }
  .btn.primary:hover { transform: translateY(-2px); filter: brightness(1.05); }
  .btn.primary:hover::after { left: 125%; }
  .btn.primary:hover {
    box-shadow:
      0 18px 48px -10px rgba(0, 240, 176, 0.8),
      inset 0 1px 0 rgba(255, 255, 255, 0.4),
      inset 0 -2px 6px rgba(0, 90, 70, 0.22);
  }
  .gh-count {
    font-family: var(--sl-font-mono, monospace);
    font-size: 0.8em; color: #ffd84d;
    border-left: 1px solid rgba(255, 255, 255, 0.16);
    padding-left: 0.55rem; margin-left: 0.15rem;
  }
  .btn.ghost { border: 1px solid rgba(0, 240, 176, 0.25); color: #eef7f0; }
  .btn.ghost:hover { transform: translateY(-2px); border-color: rgba(0, 240, 176, 0.5); }
  .arrow { transition: transform 0.2s ease; }
  .btn.primary:hover .arrow { transform: translateX(3px); }

  .cmd-row {
    display: flex; align-items: center; gap: 0.7rem;
    max-width: 36em; padding: 0.55rem 0.5rem 0.55rem 0.9rem;
    border-radius: 12px; background: rgba(8, 17, 13, 0.85);
    border: 1px solid rgba(0, 240, 176, 0.18);
    font-family: var(--sl-font-mono, monospace);
  }
  .cmd-row.small { margin-top: 0.7rem; max-width: 100%; }
  /* <code> внутри полосы — это текст терминала, а не инлайн-код:
     галактика подкладывает ему свою плашку (в светлой теме — светлую),
     и мятная команда на ней пропадает */
  .cmd-row code.cmd-text {
    background: transparent !important;
    padding: 0 !important;
    border: 0 !important;
    box-shadow: none !important;
  }
  .dollar { font-weight: 700; color: #00f0b0; flex-shrink: 0; }
  .cmd-text {
    flex: 1; min-width: 0; font-size: 0.72rem; line-height: 1.5;
    color: #62ffd2; white-space: normal; overflow-wrap: anywhere;
  }
  .cmd-copy {
    appearance: none; background: transparent; flex-shrink: 0;
    font-size: 0.65rem; letter-spacing: 0.08em; text-transform: uppercase;
    color: #a9c0b0; padding: 0.4rem 0.7rem; border-radius: 7px;
    border: 1px solid rgba(0, 240, 176, 0.2); cursor: pointer;
    transition: color 0.2s ease, border-color 0.2s ease, background 0.2s ease;
  }
  .cmd-copy:hover { color: #62ffd2; border-color: rgba(0, 240, 176, 0.45); background: rgba(0, 240, 176, 0.08); }
  .os-note { font-size: 0.78rem; color: #7f9d8e; margin-top: 0.5rem; }
  /* зеркало jsDelivr — заметная янтарная плашка, как «внимание» */
  .mirror {
    margin-top: 0.8rem; max-width: 36em;
    border: 1px solid rgba(255, 216, 77, 0.28);
    border-left: 3px solid #ffd84d;
    border-radius: 12px;
    background: rgba(255, 216, 77, 0.05);
    padding: 0.6rem 0.95rem;
  }
  .mirror summary {
    cursor: pointer; display: flex; align-items: center; gap: 0.55rem;
    font-size: 0.82rem; color: #d8e2ce; list-style: none;
  }
  .mirror summary svg { color: #ffd84d; flex: none; }
  .mirror summary::-webkit-details-marker { display: none; }
  .mirror[open] .cmd-row.small { margin-top: 0.65rem; }

  /* терминал героя: живое окно как у оригинала — высота от контента,
     никакого скролла: длинная команда переносится по строкам;
     вокруг — медленные орбиты и мягкое свечение */
  .hero-term { position: relative; min-width: 0; }
  /* фон за терминалом: сонар — кольца-эхо расходятся от окна */
  .ping {
    position: absolute; inset: -6% -12%;
    border: 1px solid rgba(0, 240, 176, 0.3);
    border-radius: 50%;
    pointer-events: none;
    animation: rr-ping 4.2s cubic-bezier(0.16, 1, 0.3, 1) infinite;
  }
  .ping.p2 { animation-delay: 1.4s; }
  .ping.p3 { animation-delay: 2.8s; }
  @keyframes rr-ping {
    0% { transform: scale(0.5); opacity: 0; }
    14% { opacity: 0.5; }
    100% { transform: scale(1.18); opacity: 0; }
  }
  .specks { position: absolute; inset: -8%; pointer-events: none; }
  .specks i {
    position: absolute; width: 4px; height: 4px; border-radius: 50%;
    background: rgba(0, 240, 176, 0.55);
    animation: rr-speck 7s ease-in-out infinite;
  }
  .specks i:nth-child(1) { left: 8%; top: 20%; }
  .specks i:nth-child(2) { right: 12%; top: 12%; width: 3px; height: 3px; background: rgba(57, 197, 207, 0.5); animation-delay: 1.8s; }
  .specks i:nth-child(3) { left: 20%; bottom: 18%; animation-delay: 3.1s; }
  .specks i:nth-child(4) { right: 6%; bottom: 28%; width: 3px; height: 3px; animation-delay: 4.4s; }
  .specks i:nth-child(5) { left: 45%; top: -2%; width: 3px; height: 3px; animation-delay: 5.6s; }
  .specks i:nth-child(6) { right: 38%; bottom: 4%; animation-delay: 2.4s; }
  @keyframes rr-speck {
    50% { transform: translateY(-16px); opacity: 0.35; }
  }
  /* включение как у ЭЛТ-монитора + развёртка на экране */
  .hero-term :global(.term) {
    animation: rr-crt-on 0.6s 0.25s cubic-bezier(0.16, 1, 0.3, 1) both;
  }
  .hero-term :global(.term)::before {
    /* статичные сканлайны */
    content: ''; position: absolute; inset: 0; z-index: 2; pointer-events: none;
    background: repeating-linear-gradient(0deg, rgba(220, 255, 238, 0.03) 0 1px, transparent 1px 3px);
  }
  @keyframes rr-crt-on {
    0% { transform: scaleY(0.04) scaleX(1.12); filter: brightness(2.4); opacity: 0; }
    55% { transform: scaleY(1.02) scaleX(0.996); filter: brightness(1.3); opacity: 1; }
    100% { transform: none; filter: none; }
  }
  .hero-term :global(.term) {
    position: relative; z-index: 1;
    margin: 0 !important;
    /* свет только внутрь окна: за границы ничего не уходит */
    box-shadow: 0 18px 44px rgba(0, 0, 0, 0.5), inset 0 0 22px rgba(0, 240, 176, 0.05);
  }
  .hero-term :global(pre) {
    font-size: 12.5px !important;
    line-height: 1.6 !important;
    min-height: 300px;
    overflow: hidden !important;
    padding: 16px 20px !important;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }
  .hero-term :global(pre .ln) { display: block; }
  .hero-term :global(.term .p-pr) { color: #00e5a0; }
  .hero-term :global(.term .p-cmd) { color: #62ffd2; }
  .hero-term :global(.term .p-sel) { color: #62ffd2; font-weight: 700; }
  /* тема даёт div+div margin-top 16px — внутри сеток карточек это ломает
     выравнивание (первая карточка без маржи, остальные сдвинуты) */
  :global(.rr-landing) :where(.stats, .path-grid, .mod-grid, .deploy-grid, .comm-cards, .marquee-track) > * {
    margin-top: 0 !important;
  }

  /* статистика: полоса с линейками — крупные цифры, никаких пилюль */
  .stats {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin: 0 0 1.7rem;
    border-block: 1px solid #172b21;
  }
  .stat {
    display: flex; flex-direction: column; gap: 0.25rem;
    padding: 0.95rem 0.4rem 0.95rem 1.15rem;
    border-left: 1px solid #172b21;
    transition: background 0.25s ease;
  }
  .stat:first-child { border-left: none; padding-left: 0.4rem; }
  .stat:hover { background: linear-gradient(180deg, rgba(0, 240, 176, 0.06), transparent); }
  .stat:hover b { text-shadow: 0 0 16px currentColor; }
  .stat b { font-family: var(--sl-font-mono, monospace); font-size: 1.7rem; font-weight: 700; line-height: 1.05; }
  .stat b.c-text { color: #eef7f0; }
  .stat b.c-mint { color: #00f0b0; }
  .stat b.c-cyan { color: #39c5cf; }
  .stat b.c-amber { color: #ffd84d; }
  .stat span { font-size: 11px; color: #7f9d8e; line-height: 1.3; }
  @media (max-width: 40rem) {
    .stats { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .stat { border-left: none; padding: 0.85rem 0.5rem; border-top: 1px solid #172b21; }
    .stat:nth-child(-n+2) { border-top: none; }
  }

  /* бегущая строка: на всю ширину */
  .marquee {
    overflow: hidden; border-block: 1px solid #172b21;
    background: rgba(11, 21, 16, 0.6);
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
  }
  .marquee-track {
    display: flex; width: max-content; gap: 2.2rem;
    padding: 0.75rem 0;
    animation: rr-marquee 36s linear infinite;
  }
  .tag {
    display: inline-flex; align-items: center; gap: 0.6rem;
    font-family: var(--sl-font-mono, monospace);
    font-size: 0.72rem; letter-spacing: 0.12em; color: #7f9d8e;
    white-space: nowrap;
  }
  .tag i { color: #00e5a0; font-style: normal; font-size: 0.6rem; }
  @keyframes rr-marquee { to { transform: translateX(-50%); } }

  /* секции: простор как у референса (py-24/py-32), чётные — с мягкой
     подложкой и рамками, чтобы страница читалась полосами */
  .sec { padding-block: clamp(3.25rem, 8vh, 5.5rem); }
  .sec.alt {
    background: rgba(11, 21, 16, 0.45);
    border-block: 1px solid #172b21;
  }
  .sec h2 {
    display: flex; align-items: center; gap: 0.6rem;
    font-family: var(--sl-font-mono, monospace);
    font-size: clamp(1.45rem, 3vw, 2.05rem);
    color: #eef7f0; margin: 0 0 1.1rem;
  }
  /* nowrap: на узких экранах «]» у [ 04 ] не должен переноситься отдельно */
  .idx { color: #00e5a0; font-size: 0.85em; letter-spacing: 0.02em; white-space: nowrap; }
  .rule { flex: 1; height: 2px; border-radius: 2px; background: linear-gradient(90deg, #2a4737, transparent); }
  .sec-sub { color: #a9c0b0; line-height: 1.7; max-width: 46em; margin: 0 0 2.1rem; }
  .dns-hint { font-size: 0.8rem; color: #7f9d8e; margin-top: 0.9rem; }

  .path-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1rem; }
  .path-card {
    display: flex; align-items: center; gap: 0.85rem;
    border: 1px solid #24402f; border-radius: 12px; background: #0f2119;
    padding: 1rem 1.1rem; font-weight: 600; color: #dcefe4; text-decoration: none;
    transition: border-color 0.2s ease, transform 0.2s ease, background 0.2s ease;
  }
  .path-card:hover { border-color: rgba(0, 229, 160, 0.45); transform: translateY(-2px); background: #10261c; }
  .path-card .num {
    font-family: var(--sl-font-mono, monospace);
    color: #ffd84d; font-weight: 700; font-size: 1.05rem;
  }
  .path-card .go, .mod-card .go {
    margin-left: auto; color: #00e5a0; font-weight: 400;
    opacity: 0; transform: translateX(-5px);
    transition: opacity 0.2s ease, transform 0.2s ease;
  }
  .path-card:hover .go, .mod-card.linked:hover .go { opacity: 1; transform: none; }

  .mod-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 1rem; }
  .mod-card {
    display: block; color: inherit; text-decoration: none;
    border: 1px solid #24402f; border-radius: 12px; background: #0f2119;
    padding: 1.15rem 1.25rem;
    transition: border-color 0.2s ease, transform 0.2s ease, background 0.2s ease;
  }
  .mod-card:hover { border-color: rgba(0, 229, 160, 0.45); transform: translateY(-2px); }
  .mod-card.linked:hover { background: #10261c; }
  .mod-head { display: flex; align-items: center; gap: 0.6rem; margin-bottom: 0.45rem; }
  .mod-head b { color: #eef7f0; font-size: 0.95rem; }
  .mod-head .num {
    font-family: var(--sl-font-mono, monospace);
    font-size: 0.65rem; color: #00e5a0; letter-spacing: 0.08em;
    border: 1px solid rgba(0, 229, 160, 0.3); border-radius: 6px; padding: 0.12rem 0.4rem;
  }
  .mod-card p { margin: 0; font-size: 0.85rem; color: #7f9d8e; line-height: 1.55; }

  .deploy-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(340px, 1fr)); gap: 1.1rem; }
  .deploy-card {
    position: relative; overflow: hidden;
    border: 1px solid #24402f; border-radius: 16px;
    background: linear-gradient(180deg, #10241b, #0f2119);
    padding: 1.5rem 1.55rem 1.4rem;
    transition: border-color 0.25s ease, transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.25s ease;
  }
  .deploy-card::after {
    content: ''; position: absolute; inset: 0; pointer-events: none;
    background: radial-gradient(420px 170px at 85% -12%, rgba(0, 240, 176, 0.07), transparent 70%);
  }
  .deploy-card:hover {
    border-color: rgba(0, 229, 160, 0.4);
    transform: translateY(-3px);
    box-shadow: 0 18px 42px -24px rgba(0, 0, 0, 0.65);
  }
  .dep-head { display: flex; align-items: center; gap: 0.9rem; margin-bottom: 0.7rem; }
  .dep-ico {
    flex: none; width: 42px; height: 42px; border-radius: 12px;
    display: inline-flex; align-items: center; justify-content: center;
    color: #00e5a0; background: rgba(0, 229, 160, 0.08);
    border: 1px solid rgba(0, 229, 160, 0.22);
  }
  .dep-ico.cyan { color: #39c5cf; background: rgba(57, 197, 207, 0.08); border-color: rgba(57, 197, 207, 0.22); }
  .dep-head h3 { margin: 0 0 0.25rem; color: #eef7f0; font-size: 1.05rem; }
  .dep-badge {
    font-family: var(--sl-font-mono, monospace);
    font-size: 10px; letter-spacing: 0.1em; text-transform: uppercase;
    color: #9db3a4; border: 1px solid #24402f; border-radius: 99px;
    padding: 0.18rem 0.55rem; white-space: nowrap;
  }
  .deploy-card p { margin: 0 0 0.9rem; font-size: 0.88rem; color: #a9c0b0; line-height: 1.6; }
  .dep-flow {
    display: flex; flex-wrap: wrap; align-items: center; gap: 0.45rem;
    margin-bottom: 1rem; font-family: var(--sl-font-mono, monospace); font-size: 0.72rem;
  }
  .dep-flow span {
    color: #dcefe4; border: 1px solid #24402f; border-radius: 7px;
    padding: 0.22rem 0.55rem; background: rgba(11, 21, 16, 0.7);
  }
  .dep-flow i { color: #7f9d8e; font-style: normal; }
  .dep-flow em { color: #7f9d8e; font-style: normal; margin-left: 0.15rem; }
  .dep-table { border: 1px solid #1a2f24; border-radius: 10px; overflow: hidden; }
  .deploy-card table { width: 100%; border-collapse: collapse; font-size: 0.8rem; }
  .deploy-card th {
    text-align: left; font-family: var(--sl-font-mono, monospace);
    color: #7f9d8e; font-weight: 500; padding: 0.45rem 0.6rem;
    background: rgba(11, 21, 16, 0.7); font-size: 0.68rem;
    text-transform: uppercase; letter-spacing: 0.08em;
  }
  .deploy-card td {
    font-family: var(--sl-font-mono, monospace);
    color: #c3d8cb; padding: 0.42rem 0.6rem; border-top: 1px solid #122019;
  }
  .deploy-card tr:last-child td:first-child { border-bottom-left-radius: 10px; }
  .rec {
    display: inline-block; font-size: 9.5px; letter-spacing: 0.08em;
    border-radius: 5px; padding: 0.14rem 0.42rem;
  }
  .rec.a { color: #00e5a0; background: rgba(0, 229, 160, 0.09); border: 1px solid rgba(0, 229, 160, 0.3); }
  .rec.cname { color: #39c5cf; background: rgba(57, 197, 207, 0.09); border: 1px solid rgba(57, 197, 207, 0.3); }
  .auto {
    display: inline-block; margin-left: 0.4rem;
    font-family: var(--sl-font-mono, monospace);
    font-size: 9px; letter-spacing: 0.08em; text-transform: uppercase;
    color: #ffd84d; border: 1px dashed rgba(255, 216, 77, 0.45); border-radius: 5px;
    padding: 0.1rem 0.34rem;
  }
  .dep-hints {
    display: flex; flex-wrap: wrap; gap: 0.6rem 1.6rem;
    margin-top: 1.1rem;
  }
  .hint {
    display: inline-flex; align-items: center; gap: 0.5rem;
    font-size: 0.8rem; color: #7f9d8e;
  }
  .hint svg { flex: none; opacity: 0.8; }
  .hint.api { color: #9db3a4; }
  .hint.api svg { color: #ffd84d; opacity: 0.9; }

  /* 04 «панель, которой нет»: слева метод доступа и защита,
     справа интерактивное демо «сканер / с ключом» */
  .hide-wrap {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
    gap: clamp(1.5rem, 3vw, 2.75rem);
    align-items: start;
  }
  .hide-left .sec-sub { margin-bottom: 1.4rem; font-size: 0.95rem; color: #b3c8b8; }
  .url-card {
    border: 1px solid #24402f; border-radius: 12px;
    background: linear-gradient(180deg, #10241b, #0f2119);
    padding: 1.15rem 1.3rem; margin-bottom: 1.25rem;
    box-shadow: 0 14px 34px -24px rgba(0, 0, 0, 0.8);
  }
  .flabel {
    display: flex; align-items: center; gap: 0.5rem;
    font-family: var(--sl-font-mono, monospace);
    font-size: 10px; letter-spacing: 0.14em; text-transform: uppercase;
    color: #7f9d8e; margin-bottom: 0.6rem;
  }
  .flabel svg { color: #00e5a0; flex: none; }
  .url-break {
    font-family: var(--sl-font-mono, monospace);
    font-size: 0.88rem; line-height: 1.8; word-break: break-all;
    color: #c3d8cb;
  }
  .u-dim { color: #6f8d7e; }
  .u-cyan { color: #39c5cf; }
  .u-mint { color: #00e5a0; }
  .u-violet { color: #a78bfa; }
  .guard {
    display: flex; align-items: center; gap: 0.6rem;
    border: 1px solid #1a2f24; border-radius: 10px;
    background: rgba(11, 21, 16, 0.55);
    padding: 0.6rem 0.75rem; font-size: 0.84rem; color: #c3d8cb;
  }
  .guard svg { color: #00e5a0; flex: none; }
  .hide-left .guard + .guard { margin-top: 0.55rem; }
  .checks { display: flex; flex-direction: column; gap: 0.65rem; margin-top: 1.2rem; }
  .check {
    display: flex; align-items: flex-start; gap: 0.6rem;
    font-size: 0.83rem; color: #a9c0b0; line-height: 1.5;
  }
  .ck {
    flex: none; width: 20px; height: 20px; margin-top: 0.05rem;
    display: inline-flex; align-items: center; justify-content: center;
    color: #00e5a0; background: rgba(0, 229, 160, 0.09);
    border: 1px solid rgba(0, 229, 160, 0.3); border-radius: 50%;
  }
  .hide-left .dep-hints { margin-top: 1.25rem; }

  .demo {
    border: 1px solid #24402f; border-radius: 16px; overflow: hidden;
    background: linear-gradient(180deg, #10241b, #0f2119);
    box-shadow: 0 20px 50px -30px rgba(0, 0, 0, 0.7);
  }
  .demo-bar {
    display: flex; align-items: center; gap: 6px;
    padding: 9px 12px;
    background: #0b1510; border-bottom: 1px solid #1d3328;
  }
  .b-dot { width: 9px; height: 9px; border-radius: 50%; flex: none; }
  .b-dot.r { background: #ff5f5680; }
  .b-dot.y { background: #ffbd2e80; }
  .b-dot.g { background: #27c93f80; }
  .demo-url {
    flex: 1; min-width: 0;
    font-family: var(--sl-font-mono, monospace); font-size: 11px;
    color: #6f8d7e; background: rgba(8, 17, 13, 0.8);
    border-radius: 6px; padding: 4px 10px;
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    transition: color 0.3s ease;
  }
  .demo-url.key { color: #62ffd2; }
  /* сцена одной высоты для обоих видов: окно не прыгает при переключении,
     лишнее место в режиме «с ключом» забирает график */
  .demo-stage {
    display: flex; flex-direction: column;
    min-height: 30rem;
  }
  .demo-view { flex: 1; display: flex; animation: dv-in 0.3s ease; }
  .demo-view[hidden] { display: none; }
  @keyframes dv-in { from { opacity: 0; } }
  .dv-scanner {
    flex-direction: column;
    align-items: center; justify-content: center; gap: 0.4rem;
    text-align: center; padding: 1.5rem;
  }
  .e404 {
    font-family: var(--sl-font-mono, monospace);
    font-size: 4.2rem; font-weight: 700; line-height: 1; color: #33503f;
  }
  .e404-sub {
    font-family: var(--sl-font-mono, monospace);
    font-size: 10px; letter-spacing: 0.34em; text-transform: uppercase;
    color: #6f8d7e; margin-bottom: 0.7rem;
  }
  .dv-owner { align-items: stretch; }
  .ov-side {
    flex: none; width: 46px;
    display: flex; flex-direction: column; align-items: center; gap: 12px;
    padding: 12px 0;
    background: rgba(8, 17, 13, 0.85);
    border-right: 1px solid #1a2f24;
  }
  .ov-logo {
    width: 22px; height: 22px; border-radius: 7px;
    background: linear-gradient(135deg, #00f0b0, #00c080);
    box-shadow: 0 0 14px rgba(0, 240, 176, 0.5);
    margin-bottom: 4px;
  }
  .ov-nav { width: 14px; height: 14px; border-radius: 5px; background: #1d3328; }
  .ov-nav.on { background: rgba(0, 229, 160, 0.35); box-shadow: inset 0 0 0 1px rgba(0, 229, 160, 0.5); }
  .ov-main { flex: 1; min-width: 0; display: flex; flex-direction: column; padding: 1rem 1.1rem 1.1rem; }
  .ov-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 0.8rem; }
  .ov-name { font-family: var(--sl-font-mono, monospace); font-size: 11px; color: #9db3a4; }
  .ov-live {
    font-family: var(--sl-font-mono, monospace); font-size: 10px;
    color: #00e5a0; background: rgba(0, 229, 160, 0.09);
    border: 1px solid rgba(0, 229, 160, 0.3); border-radius: 99px;
    padding: 0.14rem 0.55rem;
    animation: live-pulse 2.2s ease-in-out infinite;
  }
  @keyframes live-pulse { 50% { opacity: 0.5; } }
  .ov-tiles { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.55rem; margin-bottom: 0.75rem; }
  .ov-tile {
    background: rgba(11, 21, 16, 0.7); border: 1px solid #1a2f24; border-radius: 10px;
    padding: 0.6rem 0.7rem;
  }
  .ov-tile b {
    display: block; font-family: var(--sl-font-mono, monospace);
    font-size: 1rem; font-weight: 700; line-height: 1.1;
  }
  .ov-tile b.c-mint { color: #00f0b0; }
  .ov-tile b.c-cyan { color: #39c5cf; }
  .ov-tile b.c-amber { color: #ffd84d; }
  .ov-tile span {
    font-size: 9.5px; letter-spacing: 0.12em; text-transform: uppercase;
    color: #7f9d8e;
  }
  .ov-chart {
    flex: 1; min-height: 110px;
    display: flex; align-items: flex-end; gap: 6px;
    background: rgba(11, 21, 16, 0.7); border: 1px solid #1a2f24;
    border-radius: 10px; padding: 10px 10px 7px;
  }
  .ov-chart i {
    flex: 1; height: var(--h); border-radius: 4px 4px 0 0;
    background: linear-gradient(180deg, #00f0b0, rgba(0, 192, 128, 0.8));
    transform-origin: bottom; opacity: 0.85;
    animation: ov-bounce 2.6s ease-in-out infinite;
    animation-delay: calc(var(--i) * 0.14s);
  }
  @keyframes ov-bounce { 50% { transform: scaleY(0.93); } }
  .ov-nodes { display: flex; flex-direction: column; gap: 0.4rem; margin-top: 0.75rem; }
  .ov-node {
    display: flex; align-items: center; gap: 0.55rem;
    font-family: var(--sl-font-mono, monospace); font-size: 10.5px;
    color: #c3d8cb;
    background: rgba(11, 21, 16, 0.6); border: 1px solid #1a2f24;
    border-radius: 8px; padding: 0.42rem 0.65rem;
  }
  .ov-node i { font-style: normal; color: #6f8d7e; margin-left: auto; }
  .st { width: 7px; height: 7px; border-radius: 50%; flex: none; }
  .st.on { background: #00e5a0; box-shadow: 0 0 6px rgba(0, 229, 160, 0.7); }
  .st.warn { background: #ffd84d; box-shadow: 0 0 6px rgba(255, 216, 77, 0.6); }
  .demo-foot {
    display: flex; align-items: center; justify-content: center; gap: 0.8rem;
    padding: 0.85rem; border-top: 1px solid #1d3328; background: rgba(11, 21, 16, 0.5);
  }
  .seg-note {
    font-family: var(--sl-font-mono, monospace);
    font-size: 10px; letter-spacing: 0.14em; text-transform: uppercase;
    color: #6f8d7e;
  }
  .seg {
    display: inline-flex; align-items: center; gap: 2px;
    background: rgba(8, 17, 13, 0.9); border: 1px solid #1d3328;
    border-radius: 99px; padding: 3px;
  }
  .seg button {
    appearance: none; border: 0; background: transparent; cursor: pointer;
    display: inline-flex; align-items: center; justify-content: center;
    height: 30px; padding: 0 1.1rem; border-radius: 99px;
    font-family: var(--sl-font-mono, monospace);
    font-size: 11px; letter-spacing: 0.06em; text-transform: uppercase;
    line-height: 1; white-space: nowrap;
    color: #7f9d8e;
    transition: color 0.2s ease, background 0.2s ease, box-shadow 0.2s ease;
  }
  .seg button.on {
    color: #00e5a0; background: rgba(0, 229, 160, 0.1);
    box-shadow: inset 0 0 0 1px rgba(0, 229, 160, 0.35);
  }
  @media (max-width: 60rem) {
    .hide-wrap { grid-template-columns: minmax(0, 1fr); }
  }

  /* сообщество: панель с живым свечением и парящими точками */
  .community { text-align: center; }
  .community .sec-sub { margin-inline: auto; }
  .community .rule { margin-inline: auto; width: min(300px, 40%); }
  .comm-box {
    position: relative; overflow: hidden;
    border: 1px solid #24402f; border-radius: 20px;
    background: linear-gradient(180deg, #0e2118, #0b1a13);
    padding: clamp(2rem, 5vw, 3.25rem) clamp(1.25rem, 4vw, 3rem) clamp(2rem, 5vw, 3rem);
  }
  .comm-glow {
    position: absolute; inset: -30%; pointer-events: none;
    background:
      radial-gradient(38% 45% at 25% 30%, rgba(0, 240, 176, 0.09), transparent 70%),
      radial-gradient(35% 45% at 75% 65%, rgba(57, 197, 207, 0.07), transparent 70%);
    animation: comm-drift 9s ease-in-out infinite alternate;
  }
  @keyframes comm-drift {
    to { transform: translate(-3%, 4%) scale(1.1); opacity: 0.75; }
  }
  .comm-dots { position: absolute; inset: 0; pointer-events: none; }
  .comm-dots i {
    position: absolute; width: 5px; height: 5px; border-radius: 50%;
    background: rgba(0, 240, 176, 0.5);
    animation: comm-float 6s ease-in-out infinite;
  }
  .comm-dots i:nth-child(1) { left: 16%; top: 32%; }
  .comm-dots i:nth-child(2) { right: 18%; top: 26%; background: rgba(57, 197, 207, 0.45); animation-delay: 1.3s; }
  .comm-dots i:nth-child(3) { left: 30%; bottom: 22%; animation-delay: 2.6s; }
  .comm-dots i:nth-child(4) { right: 30%; bottom: 30%; width: 4px; height: 4px; animation-delay: 3.8s; }
  @keyframes comm-float {
    50% { transform: translateY(-14px); opacity: 0.35; }
  }
  .comm-box h2, .comm-box .sec-sub, .comm-cards { position: relative; }
  .comm-cards {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
    gap: 1rem; max-width: 840px; margin: 0 auto;
  }
  .comm-card {
    position: relative; display: flex; flex-direction: column; align-items: flex-start;
    gap: 0.3rem; text-decoration: none; color: inherit;
    border: 1px solid #24402f; border-radius: 14px;
    background: rgba(15, 33, 25, 0.85);
    padding: 1.15rem 1.3rem; text-align: left;
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.25s ease, box-shadow 0.25s ease;
  }
  .comm-card:hover {
    transform: translateY(-4px);
    border-color: rgba(0, 229, 160, 0.5);
    box-shadow: 0 18px 40px -20px rgba(0, 240, 176, 0.4);
  }
  .comm-card .ico {
    width: 40px; height: 40px; border-radius: 11px;
    display: inline-flex; align-items: center; justify-content: center;
    margin-bottom: 0.55rem;
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .comm-card:hover .ico { transform: scale(1.1) rotate(-4deg); }
  .comm-card.tg .ico { color: #39c5cf; background: rgba(57, 197, 207, 0.09); border: 1px solid rgba(57, 197, 207, 0.28); }
  .comm-card.gh .ico { color: #00e5a0; background: rgba(0, 229, 160, 0.09); border: 1px solid rgba(0, 229, 160, 0.28); }
  button.comm-card { appearance: none; font: inherit; width: 100%; cursor: pointer; }
  .comm-card.usdt .ico { color: #ffd84d; background: rgba(255, 216, 77, 0.09); border: 1px solid rgba(255, 216, 77, 0.28); }
  .usdt-addr {
    margin-top: 0.4rem; align-self: stretch;
    font-family: var(--sl-font-mono, monospace); font-size: 0.68rem;
    color: rgba(255, 216, 77, 0.85);
    background: rgba(255, 216, 77, 0.06); border: 1px solid rgba(255, 216, 77, 0.18);
    border-radius: 7px; padding: 0.3rem 0.55rem;
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  }
  .comm-card b { color: #eef7f0; font-size: 0.98rem; }
  .comm-card > span:not(.ico):not(.comm-go) { font-size: 0.8rem; color: #7f9d8e; line-height: 1.45; }
  .comm-go {
    position: absolute; right: 1.05rem; top: 1.2rem;
    color: #00e5a0; opacity: 0; transform: translateX(-5px);
    transition: opacity 0.2s ease, transform 0.2s ease;
  }
  .comm-card:hover .comm-go { opacity: 1; transform: none; }

  /* юридическая полоса — закрывает страницу снизу */
  .legal-strip {
    display: flex; align-items: center; justify-content: center; gap: 0.7rem;
    margin-inline: calc(-1 * var(--edge));
    padding: 0.85rem var(--edge);
    background: rgba(255, 216, 77, 0.05);
    border-top: 1px solid rgba(255, 216, 77, 0.18);
    color: #ffd84d;
  }
  .legal-strip svg { flex: none; }
  .legal-strip p { margin: 0; font-size: 0.85rem; line-height: 1.5; text-align: center; }
  /* плашка «скопировано»: всплывает снизу по центру */
  .copy-toast {
    position: fixed; bottom: 1.4rem;
    /* центр видимой области, без желоба скроллбара (--sb-w ставит скрипт) */
    left: calc((100vw - var(--sb-w, 0px)) / 2);
    transform: translate(-50%, 12px);
    display: inline-flex; align-items: center; gap: 0.5rem;
    background: #0f2119; border: 1px solid rgba(0, 229, 160, 0.45);
    border-radius: 99px; color: #eef7f0;
    font-size: 0.82rem; padding: 0.55rem 1.05rem;
    box-shadow: 0 14px 40px -12px rgba(0, 0, 0, 0.65);
    opacity: 0; pointer-events: none; z-index: 60;
    transition: opacity 0.25s ease, transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .copy-toast.show { opacity: 1; transform: translate(-50%, 0); }
  .copy-toast svg { color: #00e5a0; flex: none; }

  /* вход героя */
  .hero-copy > * { animation: rr-rise 0.7s cubic-bezier(0.16, 1, 0.3, 1) both; }
  .hero-copy > *:nth-child(1) { animation-delay: 0.05s; }
  .hero-copy > *:nth-child(2) { animation-delay: 0.12s; }
  .hero-copy > *:nth-child(3) { animation-delay: 0.2s; }
  .hero-copy > *:nth-child(4) { animation-delay: 0.28s; }
  .hero-copy > *:nth-child(5) { animation-delay: 0.36s; }
  .hero-copy > *:nth-child(6) { animation-delay: 0.42s; }
  .hero-copy > *:nth-child(7) { animation-delay: 0.48s; }
  .hero-copy > *:nth-child(8) { animation-delay: 0.54s; }
  /* подъём героя целиком заменён включением самого терминала (rr-crt-on) */
  .hero-term { animation: none; }
  @keyframes rr-rise {
    from { opacity: 0; transform: translateY(18px); }
    to { opacity: 1; transform: translateY(0); }
  }

  /* появление при скролле */
  .rr-wait { opacity: 0; transform: translateY(20px); }
  .rr-in { animation: rr-rise 0.65s cubic-bezier(0.16, 1, 0.3, 1) both; }

  @media (max-width: 56rem) {
    .hero { grid-template-columns: minmax(0, 1fr); }
    .hero .hero-term { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .marquee-track { animation: none; }
    .ping, .specks i, .ov-chart i, .ov-live, .demo-view,
    .comm-glow, .comm-dots i, .hero-term :global(.term) { animation: none; }
    .btn.primary::after { display: none; }
    .hero-copy > *, .hero-term, .stats, .rr-in { animation: none !important; }
    .rr-wait { opacity: 1; transform: none; }
  }

  /* ---------- Светлая тема: мятная бумага, белые карточки,
     тёмные экраны. Дизайн-правило то же, что у код-блоков:
     терминалы (.term, .cmd-row, .demo) — «экраны» и не светлеют. ---------- */
  :global(html[data-theme='light']) .rr-landing {
    color: #1e3c31;
    background:
      radial-gradient(900px 420px at 75% 120px, rgba(0, 146, 103, 0.05), transparent 62%),
      radial-gradient(800px 500px at 15% 40%, rgba(0, 146, 103, 0.04), transparent 60%);
  }
  :global(html[data-theme='light']) .badge {
    color: #00805a;
    border-color: rgba(0, 146, 103, 0.35);
    background: rgba(0, 146, 103, 0.06);
  }
  :global(html[data-theme='light']) .hero h1 { color: #0b2b22; }
  /* только image: шорткат background сбросил бы background-clip:text
     из базового правила, и градиент лёг бы сплошным слоем на текст */
  :global(html[data-theme='light']) .grad {
    background-image: linear-gradient(96deg, #009267 10%, #00b583 90%);
  }
  :global(html[data-theme='light']) .lead { color: #47685a; }
  :global(html[data-theme='light']) .btn.ghost {
    color: #0b2b22;
    border-color: rgba(0, 146, 103, 0.35);
  }
  :global(html[data-theme='light']) .btn.ghost:hover { border-color: rgba(0, 146, 103, 0.65); }
  :global(html[data-theme='light']) .gh-count {
    color: #8a6a00;
    border-left-color: rgba(11, 43, 34, 0.15);
  }
  /* командная строка — тёмная полоса-терминал и на светлой странице */
  :global(html[data-theme='light']) .cmd-row {
    border-color: rgba(0, 146, 103, 0.4);
    box-shadow: 0 10px 26px -16px rgba(9, 46, 33, 0.55);
  }
  :global(html[data-theme='light']) .cmd-copy {
    color: #a9c0b0;
    border-color: rgba(0, 240, 176, 0.2);
  }
  :global(html[data-theme='light']) .cmd-copy:hover {
    color: #62ffd2;
    border-color: rgba(0, 240, 176, 0.45);
    background: rgba(0, 240, 176, 0.08);
  }
  :global(html[data-theme='light']) .os-note { color: #5c7a6d; }
  /* зеркало jsDelivr — янтарная плашка на бумаге */
  :global(html[data-theme='light']) .mirror {
    background: rgba(255, 216, 77, 0.1);
    border-color: rgba(138, 106, 0, 0.28);
    border-left-color: #e0a800;
  }
  :global(html[data-theme='light']) .mirror summary { color: #4d431c; }
  :global(html[data-theme='light']) .mirror summary svg { color: #a07f00; }
  /* статистика */
  :global(html[data-theme='light']) .stats { border-color: #dcefe5; }
  :global(html[data-theme='light']) .stat { border-color: #dcefe5; }
  :global(html[data-theme='light']) .stat:hover {
    background: linear-gradient(180deg, rgba(0, 146, 103, 0.06), transparent);
  }
  :global(html[data-theme='light']) .stat b.c-text { color: #0b2b22; }
  :global(html[data-theme='light']) .stat b.c-mint { color: #00805a; }
  :global(html[data-theme='light']) .stat b.c-cyan { color: #0e7d8a; }
  :global(html[data-theme='light']) .stat b.c-amber { color: #8a6a00; }
  :global(html[data-theme='light']) .stat span { color: #5c7a6d; }
  /* бегущая строка — светлая полоса */
  :global(html[data-theme='light']) .marquee {
    background: #e9f6ef;
    border-color: #dcefe5;
  }
  :global(html[data-theme='light']) .tag { color: #5c7a6d; }
  :global(html[data-theme='light']) .tag i { color: #00805a; }
  /* секции */
  :global(html[data-theme='light']) .sec.alt {
    background: #ecf7f1;
    border-color: #dcefe5;
  }
  :global(html[data-theme='light']) .sec h2 { color: #0b2b22; }
  :global(html[data-theme='light']) .idx { color: #00805a; }
  :global(html[data-theme='light']) .rule {
    background: linear-gradient(90deg, #b9ddca, transparent);
  }
  :global(html[data-theme='light']) .sec-sub { color: #47685a; }
  /* карточки: белые с мятной рамкой */
  :global(html[data-theme='light']) .path-card,
  :global(html[data-theme='light']) .mod-card {
    background: #ffffff;
    border-color: #cfe9dc;
    color: #123b2e;
    box-shadow: 0 4px 16px -12px rgba(9, 46, 33, 0.3);
  }
  :global(html[data-theme='light']) .path-card:hover {
    border-color: rgba(0, 146, 103, 0.55);
    background: #f6fdf9;
  }
  :global(html[data-theme='light']) .mod-card:hover { border-color: rgba(0, 146, 103, 0.55); }
  :global(html[data-theme='light']) .mod-card.linked:hover { background: #f6fdf9; }
  :global(html[data-theme='light']) .mod-head b { color: #0b2b22; }
  :global(html[data-theme='light']) .mod-card p { color: #5c7a6d; }
  :global(html[data-theme='light']) .path-card .num { color: #8a6a00; }
  :global(html[data-theme='light']) .path-card .go,
  :global(html[data-theme='light']) .mod-card .go { color: #00805a; }
  :global(html[data-theme='light']) .mod-head .num {
    color: #00805a;
    border-color: rgba(0, 146, 103, 0.3);
