<div class="rr-landing not-content" id="rr-top" data-install-cmd={INSTALL_CMD}>
  <!-- первый экран: герой + бегущая строка, строка прижата к низу -->
  <div class="first">
    <section class="hero">
      <div class="hero-copy">
        <div class="badge">{T.badge}</div>
        <h1>{en ? 'Deploy' : 'Установка'}<br />Remnawave<br /><span class="h1-l2">{en ? 'in' : 'одной'} <span class="grad">{en ? 'one command.' : 'командой.'}</span></span></h1>
        <p class="lead">{T.lead}</p>

        <div class="stats">
          <div class="stat"><b class="c-text" data-count="1">1</b><span>{T.statCmd}</span></div>
          <div class="stat"><b class="c-mint" data-count="6">6</b><span>{T.statPaths}</span></div>
          <div class="stat"><b class="c-cyan" data-count="13">13</b><span>{T.statMenu}</span></div>
          <div class="stat"><b class="c-amber" data-count="2">2</b><span>{T.statWs}</span></div>
        </div>

      <div class="cta">
        <a class="btn primary" href={`${base}/installation/requirements/`}>{T.ctaStart}<span class="arrow">→</span></a>
        <a class="btn ghost" href="https://github.com/eGamesAPI/remnawave-reverse-proxy" target="_blank" rel="noopener">GitHub<span class="gh-count" data-stars>★</span></a>
      </div>

        <div class="cmd-row" title={INSTALL_CMD}>
          <span class="dollar">$</span>
          <code class="cmd-text">{INSTALL_CMD}</code>
          <button class="cmd-copy" type="button" data-copy-cmd><span data-copy-label>{T.copyBtn}</span></button>
        </div>
        <div class="os-note">{T.osNote}</div>

      <details class="mirror">
        <summary>
          <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z"/><path d="M12 9v4M12 17h.01"/></svg>
          {T.mirror}
        </summary>
        <div class="cmd-row small" title={MIRROR_CMD}>
          <span class="dollar">$</span>
          <code class="cmd-text">{MIRROR_CMD}</code>
          <button class="cmd-copy" type="button" data-copy-cmd><span data-copy-label>{T.copyBtn}</span></button>
        </div>
      </details>
      </div>

      <div class="hero-term" data-play={PLAY}>
        <div class="ping p1" aria-hidden="true"></div>
        <div class="ping p2" aria-hidden="true"></div>
        <div class="ping p3" aria-hidden="true"></div>
        <div class="specks" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i></div>
        <Terminal title="root@vps — bash" lines={[]} foot="Ubuntu 22.04+ · Debian 11+" />
      </div>
    </section>

    <!-- бегущая строка -->
    <div class="marquee" aria-hidden="true">
      <div class="marquee-track">
        {[0, 1].map(() => tags.map((t) => <span class="tag"><i>✦</i>{t}</span>))}
      </div>
    </div>
  </div>

  <!-- 01 установка -->
  <section class="sec">
    <div class="in">
      <h2><span class="idx">[ 01 ]</span>{T.s1}<span class="rule"></span></h2>
      <p class="sec-sub">{T.s1sub}</p>
      <div class="path-grid">
        {T.paths.map((p, i) => (
          <a class="path-card" href={`${base}/installation/${pathHrefs[i]}/`}>
            <span class="num">{i + 1}</span>{p}<span class="go">→</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- 02 модули -->
  <section class="sec alt">
    <div class="in">
      <h2><span class="idx">[ 02 ]</span>{T.s2}<span class="rule"></span></h2>
      <p class="sec-sub">{T.s2sub}</p>
      <div class="mod-grid">
        {T.mods.map(([num, name, desc, slug]) => {
          const card = (
            <>
              <div class="mod-head">{num && <span class="num">menu {num}</span>}<b>{name}</b>{slug && <span class="go">→</span>}</div>
              <p>{desc}</p>
            </>
          );
          return slug ? (
            <a class="mod-card linked" href={`${base}/configuration/${slug}/`}>{card}</a>
          ) : (
            <div class="mod-card">{card}</div>
          );
        })}
      </div>
    </div>
  </section>

  <!-- 03 развёртывание -->
  <section class="sec">
    <div class="in">
      <h2><span class="idx">[ 03 ]</span>{T.s3}<span class="rule"></span></h2>
      <div class="deploy-grid">
        <div class="deploy-card">
          <div class="dep-head">
            <span class="dep-ico" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="7" rx="2"/><rect x="3" y="13" width="18" height="7" rx="2"/><circle cx="7" cy="7.5" r="0.9" fill="currentColor" stroke="none"/><circle cx="7" cy="16.5" r="0.9" fill="currentColor" stroke="none"/></svg>
            </span>
            <div>
              <h3>{T.s3single}</h3>
              <span class="dep-badge">{T.depBadge1}</span>
            </div>
          </div>
          <p>{T.s3singleSub}</p>
          <div class="dep-flow">
            <span>{T.depFlow1a}</span><i>·</i><span>{T.depFlow1b}</span><i>·</i><span>{T.depFlow1c}</span><em>{T.depFlow1d}</em>
          </div>
          <div class="dep-table">
            <table>
              <thead><tr><th>{en ? 'Record' : 'Запись'}</th><th>{en ? 'Name' : 'Имя'}</th><th>{en ? 'Points to' : 'Значение'}</th></tr></thead>
              <tbody>
                <tr><td><span class="rec a">A</span></td><td>example.com</td><td>your_server_ip</td></tr>
                <tr><td><span class="rec cname">CNAME</span></td><td>panel.example.com</td><td>example.com</td></tr>
                <tr><td><span class="rec cname">CNAME</span></td><td>sub.example.com</td><td>example.com</td></tr>
                <tr><td><span class="rec cname">CNAME</span><span class="auto">{T.autoTag}</span></td><td>node.example.com</td><td>example.com</td></tr>
              </tbody>
            </table>
          </div>
        </div>
        <div class="deploy-card">
