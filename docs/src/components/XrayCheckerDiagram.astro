---
/**
 * Анимированная схема Xray Checker: панель сверху отдаёт подписку
 * служебного пользователя, чекер на отдельном сервере (пунктирный контейнер
 * с чипами чекера, статус-страницы и бота) прогоняет каждый прокси на нодах,
 * алерты уходят в Telegram. Подписи на линиях — непрозрачные чипы.
 * lang="ru" (по умолчанию) / lang="en" — язык подписей.
 */
interface Props {
  lang?: 'ru' | 'en';
}
const { lang = 'ru' } = Astro.props;
const en = lang === 'en';
---

<div class="xcd">
  <svg viewBox="0 0 640 410" role="img" aria-label={en
    ? 'Xray Checker scheme: the panel hands out the service user subscription; the checker on a separate server probes every proxy on the nodes; alerts go to Telegram'
    : 'Схема Xray Checker: панель отдаёт подписку служебного пользователя; чекер на отдельном сервере проверяет каждый прокси на нодах; алерты уходят в Telegram'}>
    <!-- панель -->
    <g class="node n-entry">
      <rect x="97" y="16" width="226" height="48" rx="11" />
      <text x="210" y="35" class="t">{en ? 'panel' : 'панель'}</text>
      <text x="210" y="52" class="s">{en ? 'user · xray-checker' : 'пользователь · xray-checker'}</text>
    </g>

    <!-- подписка: линия + чип -->
    <path class="wire w-mgmt" d="M210 64 V118" />
    <path class="flow f-mint" d="M210 64 V118" />
    <g class="pill">
      <rect x="160" y="74" width="100" height="22" rx="11" />
      <text x="210" y="89">{en ? 'subscription' : 'подписка'}</text>
    </g>

    <!-- контейнер чекера -->
    <g class="box">
      <rect x="60" y="118" width="300" height="158" rx="14" />
      <text x="210" y="142" class="bt">{en ? 'Xray Checker' : 'Xray Checker'}</text>
      <text x="210" y="160" class="bs">{en ? 'separate server · Docker' : 'отдельный сервер · Docker'}</text>
    </g>
    <g class="chip c-tb">
      <rect x="80" y="172" width="260" height="26" rx="8" />
      <circle cx="94" cy="185" r="3.5" />
      <text x="106" y="190" class="ct">{en ? 'checker' : 'чекер'}</text>
      <text x="328" y="190" class="cs">127.0.0.1:2112</text>
    </g>
    <g class="chip c-ig">
      <rect x="80" y="204" width="260" height="26" rx="8" />
      <circle cx="94" cy="217" r="3.5" />
      <text x="106" y="222" class="ct">{en ? 'status page' : 'статус-страница'}</text>
      <text x="328" y="222" class="cs">:8080</text>
    </g>
    <g class="chip c-eg">
      <rect x="80" y="236" width="260" height="26" rx="8" />
      <circle cx="94" cy="249" r="3.5" />
      <text x="106" y="254" class="ct">{en ? 'Telegram bot' : 'Telegram-бот'}</text>
      <text x="328" y="254" class="cs">{en ? 'alerts' : 'алерты'}</text>
    </g>

    <!-- проверки нод: кривые + подпись-чип в свободной середине -->
    <path class="wire w-teal" d="M360 160 C 400 168, 412 130, 440 122" />
    <path class="flow f-teal" d="M360 160 C 400 168, 412 130, 440 122" />
    <path class="wire w-teal" d="M360 230 C 400 238, 412 270, 440 282" />
    <path class="flow f-teal" d="M360 230 C 400 238, 412 270, 440 282" />
    <g class="pill">
      <rect x="398" y="186" width="120" height="22" rx="11" />
      <text x="458" y="201">{en ? 'checks via proxy' : 'проверка прокси'}</text>
    </g>

    <!-- ноды -->
    <g class="node n-vio">
      <rect x="440" y="100" width="170" height="44" rx="11" />
      <text x="525" y="119" class="t">{en ? 'node · de-fra-01' : 'нода · de-fra-01'}</text>
      <text x="525" y="135" class="s">{en ? 'every host of the sub' : 'каждый хост подписки'}</text>
    </g>
    <g class="node n-vio">
      <rect x="440" y="260" width="170" height="44" rx="11" />
      <text x="525" y="279" class="t">{en ? 'node · nl-ams-02' : 'нода · nl-ams-02'}</text>
      <text x="525" y="295" class="s">{en ? 'checked from outside' : 'проверка идёт извне'}</text>
    </g>

    <!-- алерты в Telegram: статичный приглушённый путь -->
    <path class="backup" d="M210 276 C 210 330, 156 336, 132 336" />
    <g class="node n-mgmt">
      <rect x="4" y="314" width="128" height="44" rx="11" />
      <text x="68" y="333" class="t">Telegram</text>
      <text x="68" y="349" class="s">{en ? 'alerts · /menu' : 'алерты · /menu'}</text>
    </g>

    <text x="400" y="392" class="cap mid">{en ? 'the checker probes nodes from the outside, like a regular user' : 'чекер проверяет ноды извне, как обычный пользователь'}</text>
  </svg>
</div>

<style>
  .xcd{
    background:#0a0f0c;border:1px solid #2a4737;border-radius:12px;
    padding:1rem 1.25rem;margin:1rem 0;overflow-x:auto;
    box-shadow:0 14px 40px rgba(0,0,0,.35);
  }
  .xcd svg{display:block;width:100%;min-width:600px;height:auto;
    font-family:var(--sl-font-mono, ui-monospace, Consolas, monospace)}
  .wire{fill:none;stroke:#24344a;stroke-width:2}
  .w-mgmt{stroke:#2a4737}
  .w-teal{stroke:#1d4a4d}
  .flow{fill:none;stroke-width:2;stroke-linecap:round;
    stroke-dasharray:4 12;animation:xcd-flow 1.1s linear infinite}
  .f-mint{stroke:#00e5a0}
  .f-teal{stroke:#39c5cf}
  @keyframes xcd-flow{to{stroke-dashoffset:-16}}

  .node rect{fill:#0e1a14;stroke:#2a4737;stroke-width:1.5}
  .n-mgmt rect{stroke:#2a4737;stroke-dasharray:5 4}
  .n-entry rect{stroke:rgba(0,229,160,.6)}
  .n-vio rect{stroke:rgba(188,140,255,.55)}
  .node .t{fill:#e9f4ec;font-size:16px;font-weight:600;text-anchor:middle}
  .n-entry .t{fill:#00e5a0}
  .n-vio .t{fill:#cdaaff}
  .n-mgmt .t{fill:#8ca08f}
  .node .s{fill:#a9c0b0;font-size:13px;text-anchor:middle}

  .box rect{fill:rgba(0,229,160,.02);stroke:rgba(0,229,160,.35);
    stroke-width:1.5;stroke-dasharray:7 7}
  .box .bt{fill:#00e5a0;font-size:15px;font-weight:600;text-anchor:middle}
  .box .bs{fill:#a9c0b0;font-size:12.5px;text-anchor:middle}

  .chip rect{fill:#0e1a14;stroke-width:1.5}
  .c-tb rect{stroke:rgba(0,229,160,.55)}
  .c-ig rect{stroke:rgba(88,166,255,.5)}
  .c-eg rect{stroke:rgba(188,140,255,.55)}
  .chip circle{fill:#00e5a0}
  .c-ig circle{fill:#58a6ff}
  .c-eg circle{fill:#bc8cff}
  .chip .ct{fill:#e9f4ec;font-size:13px;font-weight:600}
  .c-tb .ct{fill:#7defc4}
  .c-ig .ct{fill:#9cc7ff}
  .c-eg .ct{fill:#cdaaff}
  .chip .cs{fill:#8ca08f;font-size:12px;text-anchor:end}

  .pill rect{fill:#0a0f0c;stroke:rgba(0,229,160,.35);stroke-width:1.5}
  .pill text{fill:#a9c0b0;font-size:12px;text-anchor:middle}

  .cap{fill:#8ca08f;font-size:12.5px}
  .cap.mid{text-anchor:middle}

  .backup{fill:none;stroke:#5c6a7d;stroke-width:1.5;stroke-dasharray:3 7;opacity:.75}

  @media (prefers-reduced-motion: reduce){
    .flow{animation:none;stroke-dasharray:none;opacity:.9}
  }
</style>
