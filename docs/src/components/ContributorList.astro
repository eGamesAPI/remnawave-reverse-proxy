---
export interface Props {
  githubRepo?: `${string}/${string}`;
  ignore?: string[];
  focusColor?: string;
  lang?: "ru" | "en";
}

const {
  githubRepo = "withastro/docs",
  ignore = [],
  focusColor,
  lang = "ru",
} = Astro.props;

interface Contributor {
  username: string;
  avatar: string;
  profile: string;
  contributions: number;
}

async function getContributors(repo: string, ignoreList: string[]): Promise<Contributor[]> {
  try {
    const res = await fetch(`https://api.github.com/repos/${repo}/contributors?per_page=100`);
    if (!res.ok) {
      console.error(`Failed to fetch contributors for ${repo}: ${res.statusText}`);
      return [];
    }
    const data = await res.json();
    return data
      .filter((c: any) => !ignoreList.includes(c.login))
      .map((c: any) => ({
        username: c.login,
        avatar: c.avatar_url,
        profile: c.html_url,
        contributions: c.contributions ?? 0,
      }));
  } catch (err) {
    console.error('Error fetching contributors:', err);
    return [];
  }
}

const contributors = await getContributors(githubRepo, ignore);

// ru: 1 коммит, 2 коммита, 5 коммитов
function pluralRu(n: number) {
  const mod10 = n % 10;
  const mod100 = n % 100;
  if (mod10 === 1 && mod100 !== 11) return '';
  if (mod10 >= 2 && mod10 <= 4 && (mod100 < 10 || mod100 >= 20)) return 'а';
  return 'ов';
}
const commitsLabel = (n: number) => lang === 'en'
  ? `${n} commit${n === 1 ? '' : 's'}`
  : `${n} коммит${pluralRu(n)}`;
---

<div class="cl-window" style:--focus-color={focusColor || 'var(--sl-color-accent)'}>
  <div class="cl-bar">
    <span class="dot r"></span><span class="dot y"></span><span class="dot g"></span>
    <span class="cl-title">{githubRepo} · contributors</span>
  </div>
  <div class="contributors-list">
    {contributors.map((contributor) => (
      <a
        href={contributor.profile}
        target="_blank"
        rel="noopener noreferrer"
        class="contributor"
        title={contributor.username}
      >
        <img
          src={contributor.avatar}
          alt={contributor.username}
          loading="lazy"
        />
        <span class="name">{contributor.username}</span>
        <span class="count">{commitsLabel(contributor.contributions)}</span>
      </a>
    ))}
  </div>
</div>

<style>
  .cl-window {
    background: linear-gradient(180deg, #0b120e, #0a0f0c);
    border: 1px solid #2a4737;
    border-radius: 14px;
    margin: 1.25rem 0;
    box-shadow: 0 16px 44px rgba(0, 0, 0, 0.4);
    overflow: hidden;
  }
  .cl-bar {
    display: flex;
    align-items: center;
    gap: 7px;
    padding: 10px 14px;
    border-bottom: 1px solid rgba(0, 229, 160, 0.14);
    background: rgba(14, 26, 20, 0.55);
  }
  .dot { width: 10px; height: 10px; border-radius: 50%; flex: none; }
  .dot.r { background: #ff5f56; }
  .dot.y { background: #ffbd2e; }
  .dot.g { background: #27c93f; }
  .cl-title {
    margin-inline: auto;
    font-size: 11px;
    color: #6d8a7c;
    font-family: var(--sl-font-mono, ui-monospace, monospace);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .contributors-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    justify-content: center;
    padding: 1.1rem 1rem 1.2rem;
  }

  .contributor {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
    width: 7.2rem;
    padding: 0.75rem 0.4rem 0.65rem;
    border-radius: 12px;
    border: 1px solid transparent;
    text-decoration: none;
    transition: transform 0.2s ease, border-color 0.2s ease, background 0.2s ease;
  }
  .contributor:hover {
    transform: translateY(-2px);
    border-color: color-mix(in srgb, var(--focus-color) 35%, transparent);
    background: color-mix(in srgb, var(--focus-color) 6%, transparent);
  }

  .contributor img {
    width: 3.4rem;
    height: 3.4rem;
    border-radius: 50%;
    border: 2px solid #2f4d3b;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }
  .contributor:hover img {
    border-color: var(--focus-color);
    box-shadow: 0 0 12px color-mix(in srgb, var(--focus-color) 55%, transparent);
  }

  .name {
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--sl-color-text);
    max-width: 100%;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .count {
    font-size: 0.68rem;
    color: #7f9d8e;
    font-family: var(--sl-font-mono, ui-monospace, monospace);
  }
</style>
