---
/**
 * Диаграммы пресетов клиентского балансировщика.
 * variant="fastest": один равный пул, соединения распределяются по замеру
 * задержки между двумя лучшими. variant="reserve": основные хосты несут
 * трафик, при их недоступности клиент уходит на первый резервный.
 * lang="ru" (по умолчанию) / lang="en" — язык подписей.
 */
interface Props {
  variant?: 'fastest' | 'reserve';
  lang?: 'ru' | 'en';
}
const { variant = 'fastest', lang = 'ru' } = Astro.props;
const en = lang === 'en';
const reserve = variant === 'reserve';
---

<div class="pdi">
  <svg viewBox="0 0 640 340" role="img" aria-label={en
    ? (reserve
        ? 'Main with backup preset: traffic uses the main hosts, when they are unreachable the client moves to the first backup'
        : 'Always the fastest preset: one equal pool, connections spread across the two best hosts by measured latency')
    : (reserve
        ? 'Пресет «Основные с резервом»: трафик идёт через основные хосты, при их недоступности клиент уходит на первый резервный'
        : 'Пресет «Всегда быстрейший»: один равный пул, соединения распределяются по замеру между двумя лучшими')}>
    <!-- клиент -->
    <g class="node n-cli">
      <rect x="14" y="138" width="180" height="64" rx="14" />
      <text x="104" y="162" class="t">{en ? 'client' : 'клиент'}</text>
      <text x="104" y="180" class="s">v2rayN · Happ</text>
    </g>

    {reserve ? (
      <>
        <!-- основные -->
        <text x="541" y="52" class="grp g-main">{en ? 'main hosts' : 'основные'}</text>
        <g class="node n-dead">
          <rect x="456" y="62" width="170" height="48" rx="12" />
          <text x="541" y="84" class="t">{en ? 'Germany' : 'Германия'}</text>
          <text x="541" y="102" class="s dead">{en ? 'unreachable' : 'недоступна'}</text>
        </g>
        <g class="node n-win">
          <rect x="456" y="128" width="170" height="48" rx="12" />
          <text x="541" y="150" class="t">{en ? 'Estonia' : 'Эстония'}</text>
          <text x="541" y="168" class="s win">{en ? '34 ms · traffic' : '34 мс · трафик'}</text>
        </g>
        <!-- резерв -->
        <text x="541" y="200" class="grp g-back">{en ? 'backup' : 'резерв'}</text>
        <g class="node n-back">
          <rect x="456" y="210" width="170" height="48" rx="12" />
          <text x="541" y="232" class="t">{en ? 'Frankfurt' : 'Франкфурт'}</text>
          <text x="541" y="250" class="s">{en ? '48 ms' : '48 мс'}</text>
        </g>

        <path class="wire" d="M194 166 C 300 166, 380 86, 456 86" />
        <path class="wire w-win" d="M194 170 C 300 170, 380 152, 456 152" />
        <path class="wire w-two" d="M194 174 C 300 174, 380 234, 456 234" />
        <path class="flow f-mint" d="M194 170 C 300 170, 380 152, 456 152" />
        <path class="flow f-teal" d="M194 174 C 300 174, 380 234, 456 234" />

        <text x="322" y="132" class="cross">✖</text>
        <g class="pill">
          <rect x="241" y="252" width="190" height="22" rx="11" />
          <text x="336" y="267">{en ? 'when the mains are down' : 'когда основные недоступны'}</text>
        </g>
        <g class="chip">
          <rect x="40" y="290" width="280" height="26" rx="8" />
          <circle cx="54" cy="303" r="3.5" />
          <text x="66" y="308" class="ct">fallbackTag → {en ? 'first backup' : 'первый резервный'}</text>
        </g>
        <text x="320" y="330" class="cap mid">{en
          ? 'the main hosts carry the traffic, the first backup takes over when they are unreachable'
          : 'основные хосты несут трафик, при их недоступности вступает первый резервный'}</text>
      </>
    ) : (
      <>
        <!-- равный пул -->
        <g class="node n-pool">
          <rect x="456" y="50" width="170" height="48" rx="12" />
          <text x="541" y="72" class="t">{en ? 'Germany' : 'Германия'}</text>
          <text x="541" y="90" class="s win">{en ? '12 ms · traffic' : '12 мс · трафик'}</text>
        </g>
        <g class="node n-pool">
          <rect x="456" y="146" width="170" height="48" rx="12" />
          <text x="541" y="168" class="t">{en ? 'Estonia' : 'Эстония'}</text>
          <text x="541" y="186" class="s win">{en ? '34 ms · traffic' : '34 мс · трафик'}</text>
        </g>
        <g class="node n-pool">
          <rect x="456" y="242" width="170" height="48" rx="12" />
          <text x="541" y="264" class="t">{en ? 'Frankfurt' : 'Франкфурт'}</text>
          <text x="541" y="282" class="s dim">{en ? '48 ms' : '48 мс'}</text>
        </g>

        <path class="wire w-win" d="M194 166 C 300 166, 380 74, 456 74" />
        <path class="wire w-two" d="M194 170 C 300 170, 380 170, 456 170" />
        <path class="wire" d="M194 174 C 300 174, 380 266, 456 266" />
        <path class="flow f-mint" d="M194 166 C 300 166, 380 74, 456 74" />
        <path class="flow f-teal" d="M194 170 C 300 170, 380 170, 456 170" />

        <g class="pill">
          <rect x="261" y="112" width="150" height="22" rx="11" />
          <text x="336" y="127">{en ? 'two best in use' : 'двое лучших в деле'}</text>
        </g>
        <g class="chip">
          <rect x="40" y="290" width="215" height="26" rx="8" />
          <circle cx="54" cy="303" r="3.5" />
          <text x="66" y="308" class="ct">leastLoad · expected 2</text>
        </g>
        <text x="320" y="330" class="cap mid">{en
          ? 'one pool, every host equal, connections spread by measured latency'
          : 'один пул, все хосты равны, соединения распределяются по замеру'}</text>
      </>
    )}
  </svg>
</div>

<style>
  .pdi{
    background:#0a0f0c;border:1px solid #2a4737;border-radius:12px;
    padding:1rem 1.25rem;margin:1rem 0;overflow-x:auto;
    box-shadow:0 14px 40px rgba(0,0,0,.35);
  }
  .pdi svg{display:block;width:100%;min-width:600px;height:auto;
    font-family:var(--sl-font-mono, ui-monospace, Consolas, monospace)}
  .wire{fill:none;stroke:#24344a;stroke-width:2}
  .w-win{stroke:#2a4737}
  .w-two{stroke:#1d4a4d}
  .flow{fill:none;stroke-width:2;stroke-linecap:round;
    stroke-dasharray:4 12;animation:pdi-flow 1.1s linear infinite}
  .f-mint{stroke:#00e5a0}
  .f-teal{stroke:#39c5cf}
  @keyframes pdi-flow{to{stroke-dashoffset:-16}}

  .node rect{fill:#0e1a14;stroke:#2a4737;stroke-width:1.5}
  .n-cli rect{stroke-dasharray:5 4}
  .n-win rect{stroke:rgba(0,229,160,.55)}
  .n-back rect{stroke:rgba(188,140,255,.55)}
  .n-dead rect{opacity:.55}
  .n-pool rect{stroke:rgba(0,229,160,.35)}
  .node .t{fill:#e9f4ec;font-size:15px;font-weight:600;text-anchor:middle}
  .n-dead .t{fill:#8ca08f}
  .n-back .t{fill:#cdaaff}
  .node .s{fill:#a9c0b0;font-size:12.5px;text-anchor:middle}
  .node .s.win{fill:#7defc4}
  .node .s.dim{fill:#8ca08f}
  .node .s.dead{fill:#ff8a8a}

  .grp{font-size:11px;letter-spacing:.14em;text-transform:uppercase;text-anchor:middle}
  .g-main{fill:#7defc4}
  .g-back{fill:#cdaaff}

  .cross{fill:#ff5d5d;font-size:15px;font-weight:700;text-anchor:middle}

  .pill rect{fill:#0a0f0c;stroke:rgba(0,229,160,.35);stroke-width:1.5}
  .pill text{fill:#a9c0b0;font-size:12px;text-anchor:middle}

  .chip rect{fill:#0e1a14;stroke:rgba(0,229,160,.55);stroke-width:1.5}
  .chip circle{fill:#00e5a0}
  .chip .ct{fill:#7defc4;font-size:13px;font-weight:600}

  .cap{fill:#8ca08f;font-size:12.5px}
  .cap.mid{text-anchor:middle}

  @media (prefers-reduced-motion: reduce){
    .flow{animation:none;stroke-dasharray:none;opacity:.9}
  }
</style>
