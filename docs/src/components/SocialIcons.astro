---
/**
 * Соц-ссылки шапки с учётом языка: относительные адреса из social
 * получают префикс текущей локали, чтобы с русской страницы иконка
 * «Used resources» вела в русский раздел, а не в английский.
 */
import config from 'virtual:starlight/user-config';
import { Icon } from '@astrojs/starlight/components';

const links = config.social || [];
const locale = Astro.locals.starlightRoute?.locale;
const prefix = locale ? `/${locale}` : '';
const localized = (href: string) =>
  href.startsWith('/') && !href.startsWith(prefix) ? prefix + href : href;
---

{
	links.length > 0 && (
		<>
			{links.map(({ label, href, icon }) => (
				<a href={localized(href)} rel="me" class="sl-flex">
					<span class="sr-only">{label}</span>
					<Icon name={icon} />
				</a>
			))}
		</>
	)
}

<style>
	@layer starlight.core {
		a {
			color: var(--sl-color-text-accent);
			padding: 0.5em;
			margin: -0.5em;
		}
		a:hover {
			color: var(--sl-color-white);
		}
	}
</style>
