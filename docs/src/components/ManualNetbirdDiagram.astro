---
/**
 * Анимированная схема ручной установки NetBird: облако app.netbird.io
 * выдаёт учётную запись и setup key, по этому ключу в сеть вступают
 * сервер панели и сервер ноды, между ними поднимается туннель WireGuard,
 * и панель обращается к ноде по её адресу в сети на порт 2222
 * (порт открыт в файрволе только для адреса панели).
 * lang="ru" (по умолчанию) / lang="en" — язык подписей.
 */
interface Props {
  lang?: 'ru' | 'en';
}
const { lang = 'ru' } = Astro.props;
const en = lang === 'en';
---

<div class="mn">
  <svg viewBox="0 0 640 300" role="img" aria-label={en
    ? 'Manual NetBird scheme: the app.netbird.io cloud issues an account and a setup key; the panel server and the node server join the network with that key; a WireGuard tunnel runs between them, and the panel reaches the node at its in-network address on port 2222, opened in the firewall for the panel address only'
    : 'Схема ручной установки NetBird: облако app.netbird.io выдаёт учётную запись и setup key; по этому ключу в сеть вступают сервер панели и сервер ноды; между ними поднимается туннель WireGuard, и панель обращается к ноде по её адресу в сети на порт 2222, открытому в файрволе только для адреса панели'}>
    <!-- облако управления -->
    <g class="node n-mgmt">
      <rect x="200" y="16" width="240" height="44" rx="11" />
      <text x="320" y="35" class="t">app.netbird.io</text>
      <text x="320" y="52" class="s">{en ? 'account and setup key' : 'учётная запись и setup key'}</text>
    </g>

    <!-- вступление в сеть по ключу -->
    <path class="wire w-mgmt" d="M270 60 C 270 86, 200 90, 160 110" />
    <text x="196" y="86" class="lbl">setup key</text>
    <path class="wire w-mgmt" d="M370 60 C 370 86, 440 90, 480 110" />
    <text x="444" y="86" class="lbl">setup key</text>

    <!-- серверы -->
    <g class="node n-mint">
      <rect x="36" y="110" width="250" height="64" rx="13" />
      <text x="161" y="134" class="t">{en ? 'panel server' : 'сервер панели'}</text>
      <text x="161" y="154" class="s">netbird up --setup-key</text>
      <text x="161" y="169" class="s">100.88.38.121</text>
    </g>
    <g class="node n-vio">
      <rect x="354" y="110" width="250" height="64" rx="13" />
      <text x="479" y="134" class="t">{en ? 'node server' : 'сервер ноды'}</text>
      <text x="479" y="154" class="s">netbird up --setup-key</text>
      <text x="479" y="169" class="s">100.88.74.220</text>
    </g>

    <!-- туннель -->
    <path class="wire w-teal" d="M286 138 H354" />
    <path class="flow f-teal" d="M286 138 H354" />
    <text x="320" y="130" class="lbl">wireguard</text>

    <!-- рабочий трафик панель -> нода -->
    <path class="wire w-mint" d="M161 174 C 161 238, 479 238, 479 174" />
    <path class="flow f-mint" d="M161 174 C 161 238, 479 238, 479 174" />
    <text x="320" y="254" class="lbl">:2222 · {en ? 'node in-network address' : 'адрес ноды в сети'}</text>
    <text x="320" y="271" class="lbl dim">ufw: 2222 ← {en ? 'panel address only' : 'только для адреса панели'}</text>
  </svg>
</div>

<style>
  .mn{
    background:linear-gradient(180deg,#0b120e,#0a0f0c);
    border:1px solid #2a4737;border-radius:14px;
    padding:1.1rem 1.3rem;margin:1.25rem 0;overflow-x:auto;
    box-shadow:0 16px 44px rgba(0,0,0,.4);
  }
  .mn svg{display:block;width:100%;min-width:600px;height:auto;
    font-family:var(--sl-font-mono, ui-monospace, Consolas, monospace)}
  .wire{fill:none;stroke:#24344a;stroke-width:2}
  .w-mgmt{stroke:#2a4737;stroke-dasharray:5 5}
  .w-mint{stroke:#1d4a3c}
  .w-teal{stroke:#1d4a4d}
  .flow{fill:none;stroke-width:2.4;stroke-linecap:round;
    stroke-dasharray:4 12;animation:mn-flow 1.1s linear infinite}
  .f-mint{stroke:#00e5a0;filter:drop-shadow(0 0 4px rgba(0,229,160,.55))}
  .f-teal{stroke:#39c5cf;filter:drop-shadow(0 0 4px rgba(57,197,207,.55))}
  @keyframes mn-flow{to{stroke-dashoffset:-16}}

  .node rect{fill:#101f17;stroke:#2a4737;stroke-width:1.75}
  .n-mgmt rect{stroke:#2a4737;stroke-dasharray:5 4}
  .n-mint rect{stroke:rgba(0,229,160,.55)}
  .n-vio rect{stroke:rgba(188,140,255,.55)}
  .node .t{fill:#eef7f0;font-size:17.5px;font-weight:700;text-anchor:middle}
  .node .s{fill:#a9c0b0;font-size:12.5px;text-anchor:middle}
  .n-mint .t{fill:#00e5a0}
  .n-vio .t{fill:#cdaaff}
  .n-mgmt .t{fill:#8ca08f}
  .lbl{fill:#8ca08f;font-size:11.5px;text-anchor:middle}
  .lbl.dim{opacity:.8}

  @media (prefers-reduced-motion: reduce){
    .flow{animation:none;stroke-dasharray:none;opacity:.9}
  }
</style>
